pipeline {
    agent any

    environment {
        DOCKER_IMAGE = "sumonskys/school-management-system:latest" // Replace with your Docker Hub repo
        KUBECONFIG_CREDENTIALS_ID = "k8s-kubeconfig"              // Jenkins credential ID for kubeconfig
        DOCKER_CREDENTIALS_ID = "docker-hub-credentials"          // Jenkins credential ID for Docker
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/SchoolManagementSyestem/Backend.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    docker.build(DOCKER_IMAGE)
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', DOCKER_CREDENTIALS_ID) {
                        docker.image(DOCKER_IMAGE).push()
                    }
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                withCredentials([file(credentialsId: KUBECONFIG_CREDENTIALS_ID, variable: 'KUBECONFIG')]) {
                    sh '''
                    export KUBECONFIG=$KUBECONFIG
                    kubectl apply -f k8/deployment.yaml
                    kubectl apply -f k8/service.yaml
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Deployment successful!'
        }
        failure {
            echo 'Deployment failed.'
        }
    }
}
